# Only localhost and the cluster reach the engine and exporters (spec:
# Exposure and security). Cluster sources are node IPs because Cilium
# masquerades pod egress. SSH (22) is not filtered here: it is key-only
# (base.nix) and needed for FileVault pre-boot unlock.
{ lib, pkgs, facts, ... }:
let
  ports = "{ 8000, 9090, 9100, 9101 }";

  rulesBody = ''
    table <cluster> const { ${lib.concatStringsSep ", " facts.clusterNodeIps} }
    set skip on lo0
    # Apple's own anchors, in stock /etc/pf.conf order, so system rules still load.
    scrub-anchor "com.apple/*"
    nat-anchor "com.apple/*"
    rdr-anchor "com.apple/*"
    dummynet-anchor "com.apple/*"
    anchor "com.apple/*"
    load anchor "com.apple" from "/etc/pf.anchors/com.apple"
  '';

  passRule = "pass in quick proto tcp from <cluster> to any port ${ports}";
  # Non-cluster LAN hosts, including the admin workstation, are blocked by
  # design. For ad-hoc access to these ports use `ssh -L` through a node.
  blockRule = ''
    # Non-cluster LAN hosts, including the admin workstation, are blocked by design; use ssh -L for ad-hoc access.
    block in quick proto tcp to any port ${ports}'';

  # The label carries a hash of the full rendered filter text (apple anchors,
  # pass and block rules), so any edit to what gets loaded changes the marker
  # and the enforcer reloads it.
  marker = "home-ops-${builtins.substring 0 12 (builtins.hashString "sha256" (rulesBody + passRule + "\n" + blockRule))}";

  rules = pkgs.writeText "pf.home-ops.conf" ''
    # generated by macos/modules/pf.nix
    ${rulesBody}
    ${passRule} label "${marker}"
    ${blockRule}
  '';

  # macOS's com.apple.pfctl loads the stock /etc/pf.conf at boot and may
  # run after us, so this re-checks every minute and reloads when our
  # labelled rule is missing.
  # Output is captured once per check, not piped into grep -q: an early grep
  # exit can SIGPIPE pfctl and misreport under errexit+pipefail.
  enforce = pkgs.writeShellApplication {
    name = "pf-home-ops";
    runtimeInputs = [ pkgs.coreutils ];
    text = ''
      rules=$(/sbin/pfctl -s rules 2>/dev/null || true)
      if [[ $rules != *"${marker}"* ]]; then
        if out=$(/sbin/pfctl -f ${rules} 2>&1); then
          echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) loaded ${rules}"
        else
          echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) pfctl -f ${rules} failed: $out" >&2
        fi
        rules=$(/sbin/pfctl -s rules 2>/dev/null || true)
      fi
      info=$(/sbin/pfctl -s info 2>/dev/null || true)
      if [[ $info != *"Status: Enabled"* ]]; then
        # -E, not -e: it takes a reference, so pf stays enabled when another
        # component releases its own token. It runs only while pf is disabled,
        # so this enforcer does not accumulate references every tick.
        if out=$(/sbin/pfctl -E 2>&1); then
          :
        else
          echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) pfctl -E failed: $out" >&2
        fi
        info=$(/sbin/pfctl -s info 2>/dev/null || true)
      fi
      loaded=0
      if [[ $rules == *"${marker}"* && $info == *"Status: Enabled"* ]]; then loaded=1; fi
      dir=/var/lib/node-exporter/textfile
      tmp=$(mktemp "$dir/.pf.XXXXXX")
      {
        echo "# HELP home_ops_pf_ruleset_loaded 1 if pf is enabled with the home-ops allowlist."
        echo "# TYPE home_ops_pf_ruleset_loaded gauge"
        echo "home_ops_pf_ruleset_loaded $loaded"
      } > "$tmp"
      chmod 644 "$tmp"
      mv "$tmp" "$dir/home_ops_pf.prom"
    '';
  };
in
{
  launchd.daemons.pf-home-ops.serviceConfig = {
    ProgramArguments = [ "${enforce}/bin/pf-home-ops" ];
    RunAtLoad = true;
    StartInterval = 60;
    StandardOutPath = "/var/log/home-ops/pf-home-ops.log";
    StandardErrorPath = "/var/log/home-ops/pf-home-ops.log";
  };
}
