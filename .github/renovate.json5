{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigests',
    'github>j0sh3rs/home-ops//.renovate/autoMerge.json5',
    'github>j0sh3rs/home-ops//.renovate/customManagers.json5',
    'github>j0sh3rs/home-ops//.renovate/grafanaDashboards.json5',
    'github>j0sh3rs/home-ops//.renovate/groups.json5',
    'github>j0sh3rs/home-ops//.renovate/labels.json5',
    'github>j0sh3rs/home-ops//.renovate/semanticCommits.json5',
    ':automergeBranch',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(America/New_York)',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  ignorePaths: [
    '**/*.sops.*',
    '**/resources/**',
    '**/archive/**',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      // The engine's Python is pkgs.python312 in macos/modules/omlx.nix and
      // uv.lock is resolved for 3.12. A requires-python bump alone breaks
      // `uv sync --locked` and the engine stops (#799). Move the interpreter
      // by hand: omlx.nix, pyproject.toml and `task mac:omlx-lock` together.
      description: 'Never bump requires-python in the oMLX engine project',
      matchManagers: ['pep621'],
      matchFileNames: ['macos/engines/omlx/pyproject.toml'],
      matchDepTypes: ['requires-python'],
      enabled: false,
    },
  ],
  // macos/flake.lock. Branch-tracking inputs (nixpkgs-26.05-darwin) only
  // move via lock-file maintenance. Never automerged: merging deploys to the
  // Mac (see .renovate/autoMerge.json5).
  nix: {
    enabled: true,
    lockFileMaintenance: {
      enabled: true,
      schedule: ['before 6am on monday'],
    },
  },
}
